# ==========================================
# Security Practical CBT - Environment Config
# ==========================================

# Flask Environment (development / production)
FLASK_ENV=production
DEBUG=False

# Cryptographic secret key for session cookies and CSRF signatures
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-64-character-hex-string

# Master access key for personal/admin protected areas (/history, /wrong-notes, /dashboard)
ADMIN_ACCESS_KEY=replace-with-your-private-admin-passphrase

# Database Connection URL (PostgreSQL for Production, SQLite for Local Dev)
# In Railway, this is automatically provided by the PostgreSQL Plugin.
DATABASE_URL=postgresql://postgres:password@localhost:5432/security_cbt

# Security Cookie Flags (Set to True in HTTPS production)
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Reverse Proxy (Set to True behind Railway / Cloudflare / Nginx)
USE_PROXYFIX=True
